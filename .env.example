# Ключ модели: нужен один из двух. Если заданы оба, используется Claude.
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Claude: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Принудительный выбор: openai или anthropic (необязательно)
LLM_PROVIDER=
# Модели OpenAI (необязательно), по умолчанию gpt-5 и gpt-5-mini
OPENAI_MODEL=
OPENAI_EXTRACT_MODEL=

# Supabase: Settings -> API (Project URL и service_role key)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Telegram: токен от @BotFather и id чата группы (отрицательное число для групп)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
